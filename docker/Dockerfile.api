# ─────────────────────────────────────────────────────────────
#  FPS Connect — API Server
#  Multi-stage build: bouwt de Express-bundle met esbuild,
#  installeert vervolgens alleen de geëxternaliseerde runtime-deps.
# ─────────────────────────────────────────────────────────────

# ── Stage 1: builder ──────────────────────────────────────────
FROM node:24-alpine AS builder

RUN npm install -g pnpm@9 --no-update-notifier

WORKDIR /workspace

# Workspace-configuratie
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./

# Gedeelde libs (nodig voor esbuild/types)
COPY lib/ lib/

# API-server artifact
COPY artifacts/api-server/ artifacts/api-server/

# Volledige install (inclusief devDeps voor build)
RUN pnpm install --frozen-lockfile --ignore-scripts

# esbuild-bundle → dist/index.mjs + pino-worker bestanden
RUN pnpm --filter @workspace/api-server run build

# ── Stage 2: runtime ──────────────────────────────────────────
FROM node:24-slim AS runtime

# Vereist door sharp (native bindings)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libvips42 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Bundled applicatie
COPY --from=builder /workspace/artifacts/api-server/dist ./dist

# Installeer geëxternaliseerde runtime-deps (alleen sharp)
# pino-workers zitten al in dist/ via esbuild-plugin-pino
RUN npm install sharp@0.35.1 --no-save --no-update-notifier

# Niet-root gebruiker
RUN groupadd -g 1001 fps && useradd -u 1001 -g fps -s /bin/sh -m fps
USER fps

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -qO- http://localhost:8080/healthz || exit 1

CMD ["node", "--enable-source-maps", "./dist/index.mjs"]
