#!/bin/sh
# FPS Connect — git pre-push hook (taak #938)
#
# BLOKKEREND: een push gaat alleen door als
#   1. de opmaakschade-controle slaagt op alle te pushen commits
#      (scripts/git/check-opmaakschade.mjs — vangt merge-/formatterschade
#       zoals rapporten.ts op 15 aug 2026: 769 → 2071 regels), en
#   2. de volledige workspace-typecheck groen is (pnpm run typecheck).
#
# Activeren gebeurt automatisch via core.hooksPath .githooks (zie de
# prepare-stap in package.json). Er is bewust GEEN overslaan-vlag:
# een bewust grote wijziging kondig je aan met [grote-wijziging] in de
# commit-boodschap; een rode typecheck hoort nooit op main te belanden.

set -e
cd "$(git rev-parse --show-toplevel)"

# $1 = naam van de remote waarheen gepusht wordt (of de URL bij een anonieme push).
REMOTE_NAAM="${1:-}"

# stdin: <local ref> <local sha> <remote ref> <remote sha> per te pushen ref.
RANGES=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  # Verwijderde ref (local sha = nullen): niets te controleren.
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  case "$remote_sha" in
    0000000000000000000000000000000000000000)
      # Nieuwe remote-ref: controleer alle commits die deze remote nog niet
      # kent. Alleen als de doelremote geen trackingrefs heeft, val terug op
      # alle remote-trackingrefs; als ook die er niet zijn, wordt de hele
      # bereikbare historie gecontroleerd (rev-list zonder --not).
      if [ -n "$REMOTE_NAAM" ] && \
         git for-each-ref --count=1 "refs/remotes/$REMOTE_NAAM" 2>/dev/null | grep -q .; then
        NIEUWE=$(git rev-list "$local_sha" --not --remotes="$REMOTE_NAAM/*" 2>/dev/null || echo "")
      elif git for-each-ref --count=1 refs/remotes 2>/dev/null | grep -q .; then
        NIEUWE=$(git rev-list "$local_sha" --not --remotes 2>/dev/null || echo "")
      else
        NIEUWE=$(git rev-list "$local_sha" 2>/dev/null || echo "")
      fi
      RANGES="$RANGES $NIEUWE" ;;
    *)
      RANGES="$RANGES $remote_sha..$local_sha" ;;
  esac
done

if [ -n "$RANGES" ]; then
  echo "[pre-push] Opmaakschade-controle op te pushen commits..."
  # shellcheck disable=SC2086
  node scripts/git/check-opmaakschade.mjs $RANGES || {
    echo "[pre-push] GEBLOKKEERD: opmaakschade gedetecteerd — push niet uitgevoerd." >&2
    exit 1
  }
fi

echo "[pre-push] Volledige workspace-typecheck..."
pnpm run typecheck || {
  echo "[pre-push] GEBLOKKEERD: typecheck faalt — push niet uitgevoerd." >&2
  exit 1
}
echo "[pre-push] Alle controles groen — push gaat door."
