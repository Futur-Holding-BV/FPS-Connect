#!/bin/sh
# FPS Connect — git pre-push hook (taak #938, uitgebreid in taak #1097)
#
# BLOKKEREND: een push gaat alleen door als
#   1. geen ROLLBACKTEST/TERUGVALTEST-testmarkers in api-server bronbestanden
#      staan (scripts/check-testmarker.sh — vangt bewust kapotte startsblokken
#      die via taakmerges op main kunnen belanden, zie incident 18 aug 2026),
#   2. de opmaakschade-controle slaagt op alle te pushen commits
#      (scripts/git/check-opmaakschade.mjs — vangt merge-/formatterschade
#       zoals rapporten.ts op 15 aug 2026: 769 → 2071 regels), en
#   3. de volledige workspace-typecheck groen is (pnpm run typecheck).
#
# Activeren gebeurt automatisch via core.hooksPath .githooks (zie de
# prepare-stap in package.json). Er is bewust GEEN overslaan-vlag:
# een bewust grote wijziging kondig je aan met [grote-wijziging] in de
# commit-boodschap; een rode typecheck hoort nooit op main te belanden.

set -e
cd "$(git rev-parse --show-toplevel)"

# $1 = naam van de remote waarheen gepusht wordt (of de URL bij een anonieme push).
REMOTE_NAAM="${1:-}"

# ─── 1. Testmarker-controle (ROLLBACKTEST/TERUGVALTEST) ───────────────────────
# Blokkeert de push als er een sabotage-/terugvaltest-marker in de api-server
# bronbestanden staat. Draait altijd als allereerste controle, vóór stdin wordt
# gelezen. De takkenaam wordt afgeleid uit de huidige HEAD (de branch waarvan
# gepusht wordt); terugvaltestrakken worden bewust uitgezonderd.
echo "[pre-push] Testmarker-controle (ROLLBACKTEST/TERUGVALTEST)..."
HUIDIGE_TAK="$(git branch --show-current 2>/dev/null || git symbolic-ref --short HEAD 2>/dev/null || echo "")"
bash scripts/check-testmarker.sh "${HUIDIGE_TAK}" || {
  echo "[pre-push] GEBLOKKEERD: testmarker aangetroffen — push niet uitgevoerd." >&2
  exit 1
}

# stdin: <local ref> <local sha> <remote ref> <remote sha> per te pushen ref.
RANGES=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  # Verwijderde ref (local sha = nullen): niets te controleren.
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  case "$remote_sha" in
    0000000000000000000000000000000000000000)
      # Nieuwe remote-ref: controleer alle commits die deze remote nog niet
      # kent. Alleen als de doelremote geen trackingrefs heeft, val terug op
      # alle remote-trackingrefs; als ook die er niet zijn, wordt de hele
      # bereikbare historie gecontroleerd (rev-list zonder --not).
      if [ -n "$REMOTE_NAAM" ] && \
         git for-each-ref --count=1 "refs/remotes/$REMOTE_NAAM" 2>/dev/null | grep -q .; then
        NIEUWE=$(git rev-list "$local_sha" --not --remotes="$REMOTE_NAAM/*" 2>/dev/null || echo "")
      elif git for-each-ref --count=1 refs/remotes 2>/dev/null | grep -q .; then
        NIEUWE=$(git rev-list "$local_sha" --not --remotes 2>/dev/null || echo "")
      else
        NIEUWE=$(git rev-list "$local_sha" 2>/dev/null || echo "")
      fi
      RANGES="$RANGES $NIEUWE" ;;
    *)
      RANGES="$RANGES $remote_sha..$local_sha" ;;
  esac
done

if [ -n "$RANGES" ]; then
  echo "[pre-push] Opmaakschade-controle op te pushen commits..."
  # shellcheck disable=SC2086
  node scripts/git/check-opmaakschade.mjs $RANGES || {
    echo "[pre-push] GEBLOKKEERD: opmaakschade gedetecteerd — push niet uitgevoerd." >&2
    exit 1
  }
fi

echo "[pre-push] Volledige workspace-typecheck..."
pnpm run typecheck || {
  echo "[pre-push] GEBLOKKEERD: typecheck faalt — push niet uitgevoerd." >&2
  exit 1
}

# ─── 4. Migratienummer-botsingscontrole (MIGRATIE_DUBBEL / SCHEMA_01) ─────────
# Incident 18-08-2026: botsing 0083 blokkeerde alle uitrol. De controle
# bestond al in CI maar pas ná de push — hier wordt ze ook pre-push afgedwongen.
# Bij een botsing geeft de melding het eerstvolgende vrije nummer én het
# stap-voor-stap herstelpatroon (HERNUMMERD-entry in migrate.mjs stap 2b).
echo "[pre-push] Migratienummer-controle (MIGRATIE_DUBBEL/SCHEMA_01)..."
pnpm --filter @workspace/db run check-hernoeming || {
  echo "[pre-push] GEBLOKKEERD: migratienummer-botsing gedetecteerd — push niet uitgevoerd." >&2
  exit 1
}

echo "[pre-push] Alle controles groen — push gaat door."
