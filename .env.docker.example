# ─────────────────────────────────────────────────────────────
#  FPS Connect — Docker selfhost omgevingsvariabelen
#  Kopieer naar .env.docker en vul in.
#  Sla dit bestand NOOIT op met echte waarden in Git.
# ─────────────────────────────────────────────────────────────

# ── Domein en TLS ─────────────────────────────────────────────
DOMAIN=connect.fps-brandpreventie.nl
ACME_EMAIL=beheerder@fps-brandpreventie.nl

# ── Database ──────────────────────────────────────────────────
# Sterk wachtwoord — genereer met: openssl rand -hex 32
DB_PASSWORD=WIJZIG_MIJ

# ── Sessie ────────────────────────────────────────────────────
# Minimaal 64 tekens — genereer met: openssl rand -hex 64
SESSION_SECRET=WIJZIG_MIJ_minimaal_64_tekens

# ── MinIO (object storage) ────────────────────────────────────
MINIO_ROOT_USER=fps_storage
MINIO_ROOT_PASSWORD=WIJZIG_MIJ

# ── Microsoft Graph / e-mail ──────────────────────────────────
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID_NEW=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=WIJZIG_MIJ
MAIL_MAILBOX=postbus@fps-brandpreventie.nl
MAIL_FROM=FPS Connect <noreply@fps-brandpreventie.nl>

# ── AI ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-WIJZIG_MIJ

# ── Google Maps ───────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=WIJZIG_MIJ

# ── Feature flags ─────────────────────────────────────────────
VITE_FEATURE_PLANNING=true
VITE_FEATURE_CALCULATIE=false
