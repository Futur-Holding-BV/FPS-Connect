{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src"],
  // Deze bewijsscripts importeren api-server-bronbestanden (buiten rootDir) en
  // draaien uitsluitend via tsx. Structurele ontkoppeling (gedeeld workspace-
  // package of verhuizing naar het api-package) is een aparte opruimtaak.
  "exclude": [
    "src/bewijs-financieel-ak.ts",
    "src/bewijs-scenario-doorrekening.ts"
  ]
}
