modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-menu"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "bewijs-herschik"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "bewijs-materiaal01-fase3"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "migratie-hernoeming"

[[workflows.workflow]]
name = "e2e-menu"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run e2e-monteur-ci"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "e2e-web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run e2e-web-ci"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "bewijs-herschik"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run bewijs-herschik-ci"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "bewijs-materiaal01-fase3"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run bewijs-materiaal01-fase3-ci"

[[workflows.workflow]]
name = "migratie-hernoeming"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/db run check-hernoeming"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 420000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 8008

[[ports]]
localPort = 21646
externalPort = 5173

[[ports]]
localPort = 21647
externalPort = 8099

[[ports]]
localPort = 25392
externalPort = 80

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
MAIL_MAILBOX = "app@fpsbrandpreventie.nl"
MAIL_FROM = "noreply@fpsbrandpreventie.nl"
