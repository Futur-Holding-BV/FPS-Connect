{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "apply-additive": "node ./scripts/apply-additive.mjs",
    "reconcile": "node ./scripts/reconcile-unique.mjs",
    "migrate": "node ./scripts/migrate.mjs",
    "drift-check": "node ./scripts/schema-drift-check.mjs",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "schema-healthcheck": "node ./scripts/schema-healthcheck.mjs",
    "check-hernoeming": "node ./scripts/check-migratie-hernoeming.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.21.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
