# ─────────────────────────────────────────────────────────────
#  FPS Connect — omgevingsvariabelen (voorbeeld zonder echte waarden)
#
#  Kopieer dit bestand naar .env en vul de waarden in.
#  Sla .env NOOIT op in Git. Het staat al in .gitignore.
#
#  Zie docs/herbouw/README.md voor een volledige installatiehow-to.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string
# Formaat: postgresql://gebruiker:wachtwoord@host:5432/databasenaam
DATABASE_URL=postgresql://fps_user:WIJZIG_MIJ@localhost:5432/fps_connect

# ── Sessie ────────────────────────────────────────────────────
# Minimaal 64 tekens, genereer met: openssl rand -hex 64
SESSION_SECRET=WIJZIG_MIJ_minimaal_64_tekens_willekeurig_gegenereerd

# ── Server ────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
# Optioneel: verhoog voor meer logdetail (debug | info | warn | error)
LOG_LEVEL=info

# ── Object Storage (S3-compatibel) ────────────────────────────
# Gebruik MinIO (eigen server), Backblaze B2, AWS S3 of Cloudflare R2
S3_ENDPOINT=https://s3.example.com
S3_REGION=eu-west-1
S3_BUCKET=fps-connect-bestanden
S3_ACCESS_KEY_ID=WIJZIG_MIJ
S3_SECRET_ACCESS_KEY=WIJZIG_MIJ

# Alternatief: Google Cloud Storage (S3_BUCKET leeg laten als GCS wordt gebruikt)
# GOOGLE_CLOUD_BUCKET=fps-connect-bucket

# Pad voor privé opslag (documenten, back-ups)
PRIVATE_OBJECT_DIR=private
# Paden waaronder bestanden openbaar doorzoekbaar zijn (kommagescheiden)
PUBLIC_OBJECT_SEARCH_PATHS=public/logos,public/assets

# ── Microsoft Graph / E-mail ──────────────────────────────────
# Azure AD App Registration — zie docs/herbouw/microsoft-graph.md
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID_NEW=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=WIJZIG_MIJ

# Gedeelde postbus die e-mails verstuurt via Microsoft Graph
MAIL_MAILBOX=postbus@fps-brandpreventie.nl
# Zichtbare afzender (mag een alias zijn)
MAIL_FROM=FPS Connect <noreply@fps-brandpreventie.nl>

# ── OpenAI / AI Integrations ─────────────────────────────────
# Via Replit AI Integrations (automatisch ingevuld in Replit-omgeving)
AI_INTEGRATIONS_OPENAI_API_KEY=WIJZIG_MIJ
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Directe OpenAI key (fallback buiten Replit)
OPENAI_API_KEY=WIJZIG_MIJ

# ── Google Maps ───────────────────────────────────────────────
# Server-side Google Maps Embed API key (nooit naar client sturen)
GOOGLE_MAPS_API_KEY=WIJZIG_MIJ

# ── Domeinen (Replit-specifiek, automatisch ingevuld) ─────────
# In productie buiten Replit: stel in op je eigen domein
REPLIT_DOMAINS=connect.fps-brandpreventie.nl,one.fps-brandpreventie.nl
REPLIT_DEV_DOMAIN=localhost

# ── Frontend Feature Flags ────────────────────────────────────
# Gezet in artifacts/firevault/.env (niet hier)
# VITE_FEATURE_PLANNING=true
# VITE_FEATURE_CALCULATIE=false

# ── Expo / Mobiele app ────────────────────────────────────────
# Alleen nodig bij local Expo-development buiten Replit
# EXPO_PUBLIC_DOMAIN=https://connect.fps-brandpreventie.nl
# REPLIT_EXPO_DEV_DOMAIN=localhost

# ── E2E / CI-testen ───────────────────────────────────────────
# Pad naar Chromium op het systeem (NixOS/Linux)
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/chromium

# ── Interne routing (automatisch) ─────────────────────────────
# BASE_PATH en PORT worden door het workflow-systeem automatisch ingevuld.
# Niet handmatig instellen tenzij je buiten Replit draait.
# BASE_PATH=/
