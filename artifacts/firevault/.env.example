# ─── FPS Connect — Frontend omgevingsvariabelen ──────────────────────────────
# Kopieer naar .env voor lokale ontwikkeling.
# In productie worden deze variabelen ingebakken tijdens de Docker-build;
# ze hoeven NIET op de server aanwezig te zijn.

# ─── Vereist voor de Vite dev server ──────────────────────────────────────────
PORT=25392
BASE_PATH=/

# ─── Feature flags ────────────────────────────────────────────────────────────
VITE_FEATURE_PLANNING=true
VITE_FEATURE_CALCULATIE=false
