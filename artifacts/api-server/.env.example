# ─── FPS Connect — API Server omgevingsvariabelen ────────────────────────────
# Kopieer dit bestand naar .env en vul de waarden in.
# Gebruik NOOIT dit .env.example-bestand direct in productie.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connectiestring
DATABASE_URL=postgresql://fps:VERANDER_MIJ@localhost:5432/fps_connect

# ─── Sessies ──────────────────────────────────────────────────────────────────
# Willekeurige string van minimaal 32 tekens
# Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=VERANDER_MIJ_MINIMAAL_32_TEKENS_LANG

# ─── Object storage (S3-compatibel) ───────────────────────────────────────────
# Ondersteunde providers: AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO
#
# AWS S3:
#   S3_REGION=eu-west-1
#   S3_BUCKET=fps-connect-productie
#   S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
#   S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
#
# Cloudflare R2 (aanbevolen — geen egress-kosten):
#   S3_REGION=auto
#   S3_BUCKET=fps-connect-productie
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_ACCESS_KEY_ID=<R2-access-key>
#   S3_SECRET_ACCESS_KEY=<R2-secret-key>
#
# MinIO (self-hosted):
#   S3_REGION=us-east-1
#   S3_BUCKET=fps-connect
#   S3_ENDPOINT=https://minio.jouwdomein.nl
#   S3_ACCESS_KEY_ID=<minio-user>
#   S3_SECRET_ACCESS_KEY=<minio-password>

S3_REGION=auto
S3_BUCKET=fps-connect-productie
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=VERANDER_MIJ
S3_SECRET_ACCESS_KEY=VERANDER_MIJ

# ─── E-mail (Microsoft 365 via Microsoft Graph) ───────────────────────────────
# Zie docs/deployment.md voor het aanmaken van de Azure App Registration
MAIL_FROM=noreply@fps-brandpreventie.nl
MAIL_MAILBOX=gedeelde-postbus@fps-brandpreventie.nl
AZURE_TENANT_ID=VERANDER_MIJ
AZURE_CLIENT_ID=VERANDER_MIJ
AZURE_CLIENT_SECRET=VERANDER_MIJ

# ─── AI (OpenAI) ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=VERANDER_MIJ

# ─── Google Maps ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=VERANDER_MIJ

# ─── Verouderd (alleen Replit-dev) ────────────────────────────────────────────
# Deze variabelen zijn uitsluitend nodig op Replit (GCS-backend).
# In productie worden ze niet gebruikt wanneer S3_BUCKET is ingesteld.
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=
# PRIVATE_OBJECT_DIR=
# PUBLIC_OBJECT_SEARCH_PATHS=
