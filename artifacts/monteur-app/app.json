{
  "expo": {
    "name": "FPS Monteur",
    "slug": "monteur-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "monteur-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#212631"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "nl.fpsone.monteur",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#F23B0D"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bcb7fa55-571f-4162-a080-3a3f4761c8d9"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "@sentry/react-native/expo",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Gebruik Face ID om de FPS Monteur-app snel te ontgrendelen."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/app"
    },
    "extra": {
      "eas": {
        "projectId": "bcb7fa55-571f-4162-a080-3a3f4761c8d9"
      }
    },
    "owner": "futur-holding"
  }
}
