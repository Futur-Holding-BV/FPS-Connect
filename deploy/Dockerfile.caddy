FROM node:24-slim AS frontend-builder

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN npm install -g pnpm@10.26.1

WORKDIR /app

# Stap 1: alleen manifesten kopiëren voor gecachte dependency-installatie.
# scripts/package.json meenemen zodat pnpm de volledige workspace herkent.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.base.json tsconfig.json ./

COPY lib/api-spec/package.json            lib/api-spec/
COPY lib/api-client-react/package.json    lib/api-client-react/
COPY lib/api-client-react/tsconfig.json   lib/api-client-react/
COPY lib/api-zod/package.json             lib/api-zod/
COPY lib/api-zod/tsconfig.json            lib/api-zod/
COPY lib/db/package.json                  lib/db/
COPY lib/db/tsconfig.json                 lib/db/
COPY lib/object-storage-web/package.json  lib/object-storage-web/
COPY lib/object-storage-web/tsconfig.json lib/object-storage-web/
COPY lib/permissies/package.json          lib/permissies/
COPY lib/permissies/tsconfig.json         lib/permissies/
COPY scripts/package.json                 scripts/

COPY artifacts/firevault/package.json    artifacts/firevault/
COPY artifacts/firevault/tsconfig.json   artifacts/firevault/

COPY artifacts/monteur-app/package.json  artifacts/monteur-app/
COPY artifacts/monteur-app/tsconfig.json artifacts/monteur-app/

# --ignore-scripts voorkomt dat pnpm 'prepare: tsc --build' uitvoert
# voor lib/api-client-react terwijl de bronbestanden er nog niet zijn.
RUN pnpm install --frozen-lockfile --ignore-scripts

# Stap 2: bronbestanden kopiëren
COPY lib/ lib/
COPY artifacts/firevault/ artifacts/firevault/

# Versie-informatie, bij de build meegegeven door scripts/deploy-production.sh
# via docker-compose build-args; Vite bakt de VITE_-varianten in de webbundel.
ARG GIT_COMMIT=onbekend
ARG BUILD_TIJD=""
ARG VITE_FEATURE_WIZARD_ONBOARDING=true
ENV VITE_GIT_COMMIT=${GIT_COMMIT}
ENV VITE_BUILD_TIJD=${BUILD_TIJD}
ENV VITE_FEATURE_WIZARD_ONBOARDING=${VITE_FEATURE_WIZARD_ONBOARDING}

# Feature flags (build-time, Vite bakt ze in de webbundel).
# Onboarding-wizard is volledig getest en sinds augustus 2026 standaard AAN;
# uitschakelen kan per omgeving via build-arg/.env.production.
ARG VITE_FEATURE_WIZARD_ONBOARDING=true
ENV VITE_FEATURE_WIZARD_ONBOARDING=${VITE_FEATURE_WIZARD_ONBOARDING}

# Stap 3: Vite bouwt de frontend
RUN pnpm --filter @workspace/firevault run build

# Stap 3b: monteuromgeving (/app) — Expo web-export van de echte monteur-app.
# EXPO_PUBLIC_-variabelen worden door Metro in de webbundel gebakken; de
# service worker krijgt via sed de git-commit als cacheversie zodat elke
# uitrol zonder handmatig cache-legen zichtbaar wordt (MONTEUR_NU_01).
COPY artifacts/monteur-app/ artifacts/monteur-app/
RUN pnpm install --frozen-lockfile --ignore-scripts
RUN EXPO_PUBLIC_DOMAIN=connect.fps-one.nl \
    EXPO_PUBLIC_GIT_COMMIT=${GIT_COMMIT} \
    EXPO_PUBLIC_BUILD_TIJD=${BUILD_TIJD} \
    pnpm --filter @workspace/monteur-app exec expo export --platform web --output-dir dist-web
RUN node artifacts/monteur-app/scripts/injecteer-pwa.mjs artifacts/monteur-app/dist-web/index.html
RUN set -e; \
    test -f artifacts/monteur-app/dist-web/index.html || (echo "FOUT: monteur-app index.html ontbreekt" && exit 1); \
    grep -Fq '<link rel="manifest" href="/app/manifest.webmanifest" />' artifacts/monteur-app/dist-web/index.html || (echo "FOUT: manifest-koppeling ontbreekt in index.html" && exit 1); \
    grep -Fq '<link rel="apple-touch-icon" href="/app/icons/apple-touch-icon.png" />' artifacts/monteur-app/dist-web/index.html || (echo "FOUT: apple-touch-icon ontbreekt in index.html" && exit 1); \
    grep -Fq "navigator.serviceWorker.register('/app/sw.js',{scope:'/app/'" artifacts/monteur-app/dist-web/index.html || (echo "FOUT: service worker wordt niet met scope /app/ geregistreerd" && exit 1); \
    test "$(grep -o 'rel=\"manifest\"' artifacts/monteur-app/dist-web/index.html | wc -l)" -eq 1 || (echo "FOUT: index.html bevat niet exact één manifest-koppeling" && exit 1); \
    test "$(grep -o 'rel=\"apple-touch-icon\"' artifacts/monteur-app/dist-web/index.html | wc -l)" -eq 1 || (echo "FOUT: index.html bevat niet exact één apple-touch-icon" && exit 1); \
    test "$(grep -o 'navigator.serviceWorker.register' artifacts/monteur-app/dist-web/index.html | wc -l)" -eq 1 || (echo "FOUT: index.html bevat niet exact één service-workerregistratie" && exit 1); \
    JS=$(ls artifacts/monteur-app/dist-web/_expo/static/js/web/*.js 2>/dev/null | head -1); \
    test -n "$JS" || (echo "FOUT: geen JS-bundel in monteur-app dist-web" && exit 1); \
    test -f artifacts/monteur-app/dist-web/sw.js || (echo "FOUT: sw.js ontbreekt in monteur-app dist-web" && exit 1); \
    test -f artifacts/monteur-app/dist-web/manifest.webmanifest || (echo "FOUT: manifest ontbreekt in monteur-app dist-web" && exit 1); \
    test -f artifacts/monteur-app/dist-web/icons/pwa-192.png || (echo "FOUT: PWA-icoon 192 ontbreekt" && exit 1); \
    test -f artifacts/monteur-app/dist-web/icons/pwa-512.png || (echo "FOUT: PWA-icoon 512/maskable ontbreekt" && exit 1); \
    test -f artifacts/monteur-app/dist-web/icons/apple-touch-icon.png || (echo "FOUT: apple-touch-icon ontbreekt" && exit 1); \
    grep -Fq '"scope": "/app/"' artifacts/monteur-app/dist-web/manifest.webmanifest || (echo "FOUT: manifest-scope is niet /app/" && exit 1); \
    grep -Fq '"purpose": "maskable"' artifacts/monteur-app/dist-web/manifest.webmanifest || (echo "FOUT: maskable PWA-icoon ontbreekt in manifest" && exit 1); \
    node -e 'const fs=require("fs");const m=JSON.parse(fs.readFileSync("artifacts/monteur-app/dist-web/manifest.webmanifest","utf8"));const heeft=(src,sizes,purpose)=>m.icons?.some((i)=>i.src===src&&i.sizes===sizes&&i.type==="image/png"&&String(i.purpose??"").split(/\s+/).includes(purpose));if(m.id!=="/app/"||m.scope!=="/app/"||m.start_url!=="/app/"||m.display!=="standalone"||!heeft("/app/icons/pwa-192.png","192x192","any")||!heeft("/app/icons/pwa-512.png","512x512","any")||!heeft("/app/icons/pwa-512.png","512x512","maskable")){console.error("FOUT: manifest voldoet niet aan de Chrome-installatie-eisen");process.exit(1)}'; \
    grep -Fq 'self.addEventListener("fetch"' artifacts/monteur-app/dist-web/sw.js || (echo "FOUT: service worker mist fetch-handler" && exit 1); \
    sed -i "s/__VERSIE__/${GIT_COMMIT}/" artifacts/monteur-app/dist-web/sw.js; \
    grep -q "fps-monteur-${GIT_COMMIT}" artifacts/monteur-app/dist-web/sw.js || (echo "FOUT: sw.js versie niet vervangen" && exit 1); \
    printf '{"commit":"%s","bouwtijd":"%s"}\n' "${GIT_COMMIT}" "${BUILD_TIJD}" > artifacts/monteur-app/dist-web/versie.json; \
    # Precache-manifest: álle exportbestanden als /app/-paden, zodat de \
    # service worker bij install de complete app cachet (koude offline start). \
    (cd artifacts/monteur-app/dist-web && \
      find . -type f ! -name sw.js ! -name asset-lijst.json ! -name versie.json ! -name metadata.json \
        | sed 's|^\./|/app/|' \
        | node -e 'const l=require("fs").readFileSync(0,"utf8").trim().split("\n");process.stdout.write(JSON.stringify(l))' \
        > asset-lijst.json); \
    grep -q "_expo/static/js/web/entry-" artifacts/monteur-app/dist-web/asset-lijst.json || (echo "FOUT: asset-lijst.json mist de entry-bundel" && exit 1); \
    echo "Monteur-app webexport geverifieerd: $JS"

# Stap 4: verificeer dat de builduitvoer compleet en consistent is.
# Faalt hard als index.html, CSS of JS ontbreekt — voorkomt dat een
# incomplete build gecached en uitgerold wordt.
RUN set -e; \
    test -f artifacts/firevault/dist/public/index.html || (echo "FOUT: index.html ontbreekt" && exit 1); \
    CSS=$(ls artifacts/firevault/dist/public/assets/*.css 2>/dev/null | head -1); \
    test -n "$CSS" || (echo "FOUT: geen CSS-bestand in dist/public/assets/" && exit 1); \
    JS=$(ls artifacts/firevault/dist/public/assets/*.js 2>/dev/null | head -1); \
    test -n "$JS" || (echo "FOUT: geen JS-bestand in dist/public/assets/" && exit 1); \
    HASH_CSS=$(basename "$CSS"); \
    grep -q "$HASH_CSS" artifacts/firevault/dist/public/index.html || \
        (echo "FOUT: index.html verwijst niet naar $HASH_CSS — build inconsistent" && exit 1); \
    echo "Buildverificatie geslaagd: $CSS en $JS aanwezig en consistent met index.html"

FROM caddy:2-alpine AS runtime

COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=frontend-builder /app/artifacts/firevault/dist/public /srv/public
COPY --from=frontend-builder /app/artifacts/firevault/dist/public /opt/sentry/firevault
COPY --from=frontend-builder /app/artifacts/monteur-app/dist-web /srv/app
RUN find /srv/public -type f -name '*.map' -delete

EXPOSE 80 443
