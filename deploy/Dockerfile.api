FROM node:24-slim AS builder

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Stap 1: manifesten kopiëren vóór pnpm install (cache-laag)
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.base.json tsconfig.json ./

# lib-packages (alle, want pnpm-workspace.yaml includeert lib/*)
COPY lib/api-spec/package.json            lib/api-spec/
COPY lib/api-client-react/package.json    lib/api-client-react/
COPY lib/api-client-react/tsconfig.json   lib/api-client-react/
COPY lib/api-zod/package.json             lib/api-zod/
COPY lib/api-zod/tsconfig.json            lib/api-zod/
COPY lib/db/package.json                  lib/db/
COPY lib/db/tsconfig.json                 lib/db/
COPY lib/object-storage-web/package.json  lib/object-storage-web/
COPY lib/object-storage-web/tsconfig.json lib/object-storage-web/
COPY lib/permissies/package.json          lib/permissies/
COPY lib/permissies/tsconfig.json         lib/permissies/
COPY artifacts/api-server/package.json    artifacts/api-server/
COPY artifacts/api-server/tsconfig.json   artifacts/api-server/

# --ignore-scripts voorkomt dat pnpm 'prepare: tsc --build' uitvoert
# voor lib/api-client-react terwijl de bronbestanden er nog niet zijn
RUN pnpm install --frozen-lockfile --ignore-scripts

# Stap 2: bronbestanden kopiëren
COPY lib/ lib/
COPY artifacts/api-server/ artifacts/api-server/

# Stap 3: libs compileren (bouwt o.a. lib/api-client-react declaraties)
RUN pnpm run typecheck:libs

# Stap 4: api-server bundelen via esbuild
RUN pnpm --filter @workspace/api-server run build

# Stap 5: pnpm deploy maakt een schone, symlink-vrije productie-node_modules.
# Dit is de aanbevolen aanpak voor pnpm-workspaces in Docker: alle runtime-
# dependencies worden correct opgelost zonder afhankelijkheid van de
# virtuele store-symlinks die bij COPY --from=builder kapot kunnen gaan.
RUN pnpm deploy --filter @workspace/api-server --prod --legacy /app/deploy

FROM node:24-slim AS runtime

RUN addgroup --system fps && adduser --system --ingroup fps fps
WORKDIR /app

COPY --from=builder /app/artifacts/api-server/dist ./dist
COPY --from=builder /app/deploy/node_modules ./node_modules

USER fps

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:' + (process.env.PORT||8080) + '/api/healthz', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"

ENV NODE_ENV=production
ENV PORT=8080

EXPOSE 8080

CMD ["node", "--enable-source-maps", "dist/index.mjs"]
