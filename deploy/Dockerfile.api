FROM node:24-slim AS builder

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN npm install -g pnpm@10.26.1

WORKDIR /app

# Stap 1: manifesten kopiëren vóór pnpm install (cache-laag)
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.base.json tsconfig.json ./

# lib-packages (alle, want pnpm-workspace.yaml includeert lib/*)
COPY lib/api-spec/package.json            lib/api-spec/
COPY lib/api-client-react/package.json    lib/api-client-react/
COPY lib/api-client-react/tsconfig.json   lib/api-client-react/
COPY lib/api-zod/package.json             lib/api-zod/
COPY lib/api-zod/tsconfig.json            lib/api-zod/
COPY lib/db/package.json                  lib/db/
COPY lib/db/tsconfig.json                 lib/db/
COPY lib/foutmonitoring/package.json      lib/foutmonitoring/
COPY lib/foutmonitoring/tsconfig.json     lib/foutmonitoring/
COPY lib/object-storage-web/package.json  lib/object-storage-web/
COPY lib/object-storage-web/tsconfig.json lib/object-storage-web/
COPY lib/permissies/package.json          lib/permissies/
COPY lib/permissies/tsconfig.json         lib/permissies/
COPY artifacts/api-server/package.json    artifacts/api-server/
COPY artifacts/api-server/tsconfig.json   artifacts/api-server/

# --ignore-scripts voorkomt dat pnpm 'prepare: tsc --build' uitvoert
# voor lib/api-client-react terwijl de bronbestanden er nog niet zijn
RUN pnpm install --frozen-lockfile --ignore-scripts

# Stap 2: bronbestanden kopiëren
COPY lib/ lib/
COPY artifacts/api-server/ artifacts/api-server/

# Stap 3: typecheck ín het image — alleen wanneer de controle vooraf is
# overgeslagen (NOODFIX-uitrol). Bij een normale deploy heeft de workflow de
# volledige workspace-typecheck al op de runner gedraaid; hem hier herhalen
# was pure dubbeling en maakte elke bouwstap minuten langer. esbuild (stap 4)
# stript types zonder controle en heeft de lib-declaraties niet nodig (alle
# @workspace-packages exporteren ./src/*.ts), dus overslaan is veilig.
# Default "1" (wél checken): iedereen die dit image buiten de pipeline bouwt,
# krijgt de veilige variant; alleen deploy-production.sh zet hem uit.
ARG TYPECHECK_IN_IMAGE=1
RUN if [ "${TYPECHECK_IN_IMAGE}" = "1" ]; then \
      pnpm run typecheck:libs && \
      pnpm --filter @workspace/api-server run typecheck; \
    else \
      echo "Typecheck in image overgeslagen: al op de Actions-runner gedraaid."; \
    fi

# Stap 4: api-server bundelen via esbuild
RUN pnpm --filter @workspace/api-server run build

# Stap 5: pnpm deploy maakt een schone, symlink-vrije productie-node_modules.
# Dit is de aanbevolen aanpak voor pnpm-workspaces in Docker: alle runtime-
# dependencies worden correct opgelost zonder afhankelijkheid van de
# virtuele store-symlinks die bij COPY --from=builder kapot kunnen gaan.
RUN pnpm deploy --filter @workspace/api-server --prod --legacy /app/deploy

FROM node:24-slim AS runtime

# Externe programma's die de api-server op runtime aanroept:
#  - poppler-utils (pdftoppm): PDF→afbeelding voor AI-vision (document-
#    classificatie van scans zonder tekstlaag, contract-analyse)
#  - postgresql-client-16 (pg_dump/psql): dagelijkse back-up + herstel draaien
#    ín deze container (backupService); versie 16 moet matchen met de server
#  - chromium + fonts: offerte-PDF en PIM-adviesrapport-PDF (headless render)
#  - p7zip-full (7z): archief-veiligheidsscan van 7z/RAR-uploads (fail-closed:
#    zonder binary worden zulke archieven geblokkeerd)
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates gnupg \
 && install -d /usr/share/postgresql-common/pgdg \
 && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
      | gpg --dearmor -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg \
 && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      poppler-utils \
      postgresql-client-16 \
      chromium \
      fonts-liberation fonts-dejavu-core \
      p7zip-full \
 && apt-get purge -y curl gnupg \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

RUN addgroup --system fps && adduser --system --ingroup fps fps
WORKDIR /app

COPY --from=builder /app/artifacts/api-server/dist ./dist
COPY --from=builder /app/deploy/node_modules ./node_modules

USER fps

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:' + (process.env.PORT||8080) + '/api/healthz', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"

ENV NODE_ENV=production
ENV PORT=8080

# Versie-informatie, bij de build meegegeven door scripts/deploy-production.sh
# via docker-compose build-args; zichtbaar in de app via GET /api/versie.
ARG GIT_COMMIT=onbekend
ARG BUILD_TIJD=""
ARG DEPLOY_NUMMER=""
ENV GIT_COMMIT=${GIT_COMMIT}
ENV BUILD_TIJD=${BUILD_TIJD}
ENV DEPLOY_NUMMER=${DEPLOY_NUMMER}

EXPOSE 8080

CMD ["node", "--enable-source-maps", "dist/index.mjs"]
