# FPS Connect — Productie omgevingsvariabelen
# Kopieer naar .env.production en vul alle waarden in.
# Sla dit bestand NOOIT op met echte waarden in versiebeheer.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://fps_app:CHANGEME@db:5432/fps_production

# ── Sessie ────────────────────────────────────────────────────────────────────
# Genereer met: openssl rand -base64 48
SESSION_SECRET=CHANGEME_min64tekens

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
LOG_LEVEL=warn

# ── AI (kies één van de twee opties) ─────────────────────────────────────────
# Optie A — eigen OpenAI API-sleutel:
OPENAI_API_KEY=sk-...

# Optie B — via Replit AI Integrations proxy (alleen als Replit build-omgeving):
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://...
# AI_INTEGRATIONS_OPENAI_API_KEY=...

# AI-features in/uitschakelen (true/false)
CONNECT_AI_ENABLED=true

# ── Frontend feature-flags (build-time, ingebakken in de webbundel) ──────────
# Onboarding-wizard onder /personeel/onboarden (default aan sinds 2026-08-07)
VITE_FEATURE_WIZARD_ONBOARDING=true

# ── Google Maps ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIza...

# ── Mail via Microsoft 365 Graph API ─────────────────────────────────────────
MAIL_VIA_GRAPH=true
MAIL_FROM=noreply@fpsbrandpreventie.nl
MAIL_MAILBOX=app@fpsbrandpreventie.nl
AZURE_CLIENT_ID_NEW=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=CHANGEME
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Object Storage (kies één optie) ──────────────────────────────────────────
# Optie A — S3-compatible (MinIO in de compose-stack, AWS S3, Cloudflare R2):
S3_BUCKET=fps-production
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=fps_minio
S3_SECRET_ACCESS_KEY=CHANGEME_zelfde_als_MINIO_ROOT_PASSWORD
# Intern endpoint (server-side lezen/schrijven; binnen het Docker-netwerk):
S3_ENDPOINT=http://minio:9000
# Publiek endpoint voor presigned browser-uploads. Caddy stuurt
# https://<domein>/fps-production/* door naar minio:9000 (zie Caddyfile).
S3_PUBLIC_ENDPOINT=https://connect.fps-one.nl

# MinIO root-credentials (alleen bij Optie A met MinIO in de compose-stack;
# gelezen door de services minio en minio-init in docker-compose.production.yml)
MINIO_ROOT_USER=fps_minio
MINIO_ROOT_PASSWORD=CHANGEME

# Optie B — Google Cloud Storage:
# GCS_BUCKET=fps-production
# GOOGLE_CLOUD_BUCKET=fps-production
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs-keyfile.json

# Storage-paden (relatief aan bucket root)
PRIVATE_OBJECT_DIR=private
PUBLIC_OBJECT_SEARCH_PATHS=public

# ── Feature flags (build-time; Vite bakt ze in de webbundel) ─────────────────
# Onboarding-wizard in HRM (standaard AAN sinds augustus 2026).
# Wijzigen vereist een nieuwe frontend-build (docker compose build caddy).
VITE_FEATURE_WIZARD_ONBOARDING=true

# ── AVG / dataretentie ────────────────────────────────────────────────────────
# Bewaarperiode activiteitslog in dagen (standaard 365)
AVG_ACTIVITEIT_BEWAARDAGEN=365
